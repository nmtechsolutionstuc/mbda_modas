# ── Base de datos (Supabase) ─────────────────────────────────
# URL del pooler (Transaction mode) — usada por Prisma en runtime
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa — usada por Prisma para migraciones
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
JWT_REFRESH_SECRET="cambia_esto_por_otro_secreto_largo_y_aleatorio"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="60d"

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ── Almacenamiento de fotos ──────────────────────────────────
# "local" para desarrollo, "cloudinary" para producción
STORAGE_PROVIDER="local"

# Cloudinary (solo si STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
