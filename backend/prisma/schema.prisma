generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum ProductKind {
  PHYSICAL
  SERVICE
  DIGITAL
}

enum OrderStatus {
  PENDING
  PROOF_RECEIVED
  CONFIRMED
  DISPATCHED
  CANCELLED
}

enum SaleMode {
  PRESENCIAL
  ONLINE
}

enum PickupBy {
  BUYER
  RESELLER
}

enum PaymentMethod {
  TRANSFER
  CASH
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

// SALE = comisión normal de la venta. BONUS = extra que MBDA suma de su propio
// margen cuando la facturación del revendedor en el ciclo supera un umbral
// (CycleBonusTier) — no sale del precio que la revendedora le puso al producto.
enum CommissionKind {
  SALE
  BONUS
}

enum AdminRole {
  ADMIN
  SUBADMIN
}

enum ResellerLevel {
  INICIAL
  BRONCE
  PLATA
  ORO
}

enum CycleStatus {
  OPEN
  CLOSED
  PREPARING
  DISPATCHED
}

enum StoreTheme {
  ELEGANTE
  VARONIL
  NARANJA
  ROSA
  MINIMAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Cómo recibe la revendedora la mercadería del ciclo cerrado. Solo aplica
// cuando no es de Concepción: ahí siempre retira en el local sin importar
// este valor (se ignora). Fuera de Concepción, ella elige una de las dos.
enum DeliveryMethod {
  PICKUP
  SHIPPING
}

// ─────────────────────────────────────────────────────────────
// ADMIN — Gestiona productos, pedidos y configuración
// ─────────────────────────────────────────────────────────────

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// RESELLER — Arma catálogos y vende a sus clientes
// ─────────────────────────────────────────────────────────────

model Reseller {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  dni             String?
  whatsapp        String
  email           String    @unique
  passwordHash    String
  cbu             String?
  alias           String?
  storeName       String
  storeSlug       String    @unique
  storePhoto      String?
  storeBio        String?   // frase corta que la revendedora elige para el hero de su tienda pública
  address         String?
  city            String?
  postalCode      String?
  // Solo tiene efecto si la revendedora NO es de Concepción — ahí siempre
  // retira en el local. Fuera de Concepción, ella elige retiro o despacho.
  deliveryMethod  DeliveryMethod @default(SHIPPING)
  level           ResellerLevel @default(INICIAL)
  storeTheme      StoreTheme @default(ELEGANTE) // paleta de colores + tipografía de la tienda pública
  lifetimeRevenue Decimal   @default(0) @db.Decimal(14, 2) // facturación acumulada histórica — nunca baja, define el nivel
  referralCode    String    @unique
  isActive        Boolean   @default(true)
  // Autoregistro queda PENDING hasta que el admin lo apruebe; alta manual desde
  // el admin nace APPROVED directamente. isActive sigue controlando activar/
  // desactivar una cuenta YA aprobada — son ejes independientes.
  approvalStatus  ApprovalStatus @default(APPROVED)
  termsAcceptedAt DateTime
  onboardingSeenAt DateTime? // null = todavía no vio la pantalla de bienvenida
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  catalogItems  CatalogItem[]
  orders        Order[]
  commissions   Commission[]

  @@index([referralCode])
  @@index([storeSlug])
  @@map("resellers")
}

// ─────────────────────────────────────────────────────────────
// LEVEL CONFIG — Umbral, comisión y tope de aumento por nivel de revendedora.
// Fila fija por nivel (una por cada valor del enum ResellerLevel), editable
// desde admin. Los valores de prueba iniciales son los del prompt maestro.
// ─────────────────────────────────────────────────────────────

model LevelConfig {
  level           ResellerLevel @id
  thresholdAmount Decimal       @db.Decimal(14, 2) // facturación acumulada para alcanzar este nivel
  commissionPct   Decimal       @db.Decimal(5, 2)  // comisión cuando el revendedor vende al precio oficial
  maxMarkupPct    Decimal       @db.Decimal(5, 2)  // tope máximo de aumento sobre el precio oficial
  updatedAt       DateTime      @updatedAt

  @@map("level_configs")
}

// ─────────────────────────────────────────────────────────────
// REFRESH TOKEN — Solo para revendedores. Admin no persiste refresh.
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resellerId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// CATEGORY — Categorías de productos
// ─────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT — Productos de MBDA Modas
// ─────────────────────────────────────────────────────────────

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String?
  basePrice     Decimal     @db.Decimal(12, 2)
  photos        String[]
  youtubeVideoUrl String?   // video de YouTube que se embebe en el detalle de la prenda
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  commissionPct Decimal     @db.Decimal(5, 2) @default(20)
  kind          ProductKind @default(PHYSICAL)
  ownerId       String?     // Referencia interna opcional (admin)
  isActive      Boolean     @default(true)
  availableForResellers Boolean @default(true)  // los revendedores pueden agregarla a su catálogo
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  variants     ProductVariant[]
  catalogItems CatalogItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT VARIANT — Combinación talle/color con stock
// ─────────────────────────────────────────────────────────────

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────
// CATALOG ITEM — Producto en el catálogo de un revendedor
// ─────────────────────────────────────────────────────────────

model CatalogItem {
  id           String   @id @default(uuid())
  resellerId   String
  reseller     Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPrice Decimal  @db.Decimal(12, 2)
  saleMode     SaleMode @default(ONLINE)
  visible      Boolean  @default(true) // la revendedora puede ocultarlo de su tienda sin quitarlo del catálogo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resellerId, productId, saleMode])
  @@index([resellerId])
  @@index([productId])
  @@map("catalog_items")
}

// ─────────────────────────────────────────────────────────────
// CYCLE — Ciclo de compra: agrupa los pedidos confirmados entre un cierre y
// el siguiente. Admin define cuándo cierra y cuándo se despacha.
// ─────────────────────────────────────────────────────────────

model Cycle {
  id         String      @id @default(uuid())
  number     Int         @unique @default(autoincrement()) // "Ciclo #42" — solo para mostrar
  closeAt    DateTime
  dispatchAt DateTime
  status     CycleStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  orders Order[]

  @@map("cycles")
}

// ─────────────────────────────────────────────────────────────
// ORDER — Pedido creado por un comprador en el catálogo de un revendedor
// ─────────────────────────────────────────────────────────────

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  resellerId       String
  reseller         Reseller       @relation(fields: [resellerId], references: [id])
  buyerName        String
  buyerWhatsapp    String
  buyerEmail       String?
  buyerNote         String?        @db.Text  // Nota libre del comprador (referencia, aclaraciones, etc.)
  trackingNumber    String?                   // referencia opcional al despachar a la dirección del revendedor
  pickupBy          PickupBy       @default(BUYER)   // quién retira en el local: el comprador o el revendedor
  paymentMethod     PaymentMethod?                    // cómo pagó el comprador (flujo de reserva del revendedor)
  cashDueDate       DateTime?                         // fecha tope de entrega/cobro cuando paymentMethod=CASH
  pickupDeadline    DateTime?                         // vencimiento del retiro en el local (seteado al confirmar)
  cycleId           String?                           // ciclo de compra al que pertenece (asignado al confirmar)
  cycle             Cycle?         @relation(fields: [cycleId], references: [id])
  subtotal         Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  status           OrderStatus    @default(PENDING)
  cancelReason     String?
  reservedUntil    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items       OrderItem[]
  commissions Commission[]

  @@index([resellerId])
  @@index([status])
  @@index([cycleId])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────
// ORDER ITEM — Línea de pedido con snapshot de precios
// ─────────────────────────────────────────────────────────────

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  productName   String
  productId     String
  size          String
  color         String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  basePrice     Decimal        @db.Decimal(12, 2)
  commissionPct Decimal        @db.Decimal(5, 2)
  subtotal      Decimal        @db.Decimal(12, 2)
  cancelled     Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// COMMISSION — Comisión generada al confirmar un pedido
// ─────────────────────────────────────────────────────────────

model Commission {
  id         String           @id @default(uuid())
  resellerId String
  reseller   Reseller         @relation(fields: [resellerId], references: [id])
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id])
  amount     Decimal          @db.Decimal(12, 2)
  kind       CommissionKind   @default(SALE)
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([resellerId])
  @@index([orderId])
  @@map("commissions")
}

// ─────────────────────────────────────────────────────────────
// CYCLE BONUS TIER — Recompensa extra por volumen de ventas DENTRO de un
// mismo ciclo de compra (se reinicia cada ciclo). A partir de thresholdAmount
// de facturación en el ciclo, MBDA suma bonusPct de su propio margen sobre el
// precio base de cada venta — no achica ni depende de lo que la revendedora
// haya puesto como precio de venta. Editable desde admin, cantidad de filas
// libre (no es un enum fijo como los niveles).
// ─────────────────────────────────────────────────────────────

model CycleBonusTier {
  id              String   @id @default(uuid())
  thresholdAmount Decimal  @db.Decimal(12, 2)
  bonusPct        Decimal  @db.Decimal(5, 2)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cycle_bonus_tiers")
}

// ─────────────────────────────────────────────────────────────
// CONFIG AUDIT LOG — Registro inmutable de cambios críticos
// ─────────────────────────────────────────────────────────────

model ConfigAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String
  field     String   // 'cbu' | 'alias' | 'whatsapp'
  oldValue  String   // enmascarado
  newValue  String   // enmascarado
  ip        String?
  createdAt DateTime @default(now())

  @@index([field])
  @@map("config_audit_logs")
}

// ─────────────────────────────────────────────────────────────
// RESELLER AUDIT LOG — Cambios sensibles hechos por el admin sobre la
// cuenta de una revendedora (CBU/alias propios, DNI, dirección) — mismo
// patrón que ConfigAuditLog pero por revendedora.
// ─────────────────────────────────────────────────────────────

model ResellerAuditLog {
  id           String   @id @default(uuid())
  resellerId   String
  resellerName String
  adminId      String
  adminName    String
  field        String   // 'cbu' | 'alias' | 'dni' | 'address' | 'city' | 'postalCode'
  oldValue     String   // enmascarado si aplica
  newValue     String   // enmascarado si aplica
  ip           String?
  createdAt    DateTime @default(now())

  @@index([resellerId])
  @@index([field])
  @@map("reseller_audit_logs")
}

// ─────────────────────────────────────────────────────────────
// COURSE VIDEO — Videos de YouTube de capacitación para revendedoras, se
// cargan progresivamente desde el admin. No públicos: solo visibles para
// revendedoras logueadas en su panel ("Cursos").
// ─────────────────────────────────────────────────────────────

model CourseVideo {
  id          String   @id @default(uuid())
  title       String
  youtubeUrl  String
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_videos")
}

// ─────────────────────────────────────────────────────────────
// CONFIG — Registro único (singleton) de configuración global
// ─────────────────────────────────────────────────────────────

model Config {
  id                   String    @id @default("singleton")
  cbu                  String    @default("")
  alias                String    @default("")
  whatsapp             String    @default("")
  dispatchDays         Int       @default(3)
  stockReserveHours    Int       @default(24)
  maxCashDeliveryDays  Int       @default(2)
  pickupExpiryHours    Int       @default(48)

  // ── Armador de outfits (no generativo, V1) ──────────────────
  outfitBuilderEnabled Boolean   @default(true)

  // ── Límite de revendedoras por ciudad (off por defecto) ─────
  cityResellerLimitEnabled Boolean @default(false)
  cityResellerLimitCount   Int     @default(5)

  // ── Ayuda ────────────────────────────────────────────────────
  helpUrl              String    @default("")
  termsContent         String?   @db.Text
  termsUpdatedAt       DateTime?
  privacyPolicyContent   String?   @db.Text
  privacyPolicyUpdatedAt DateTime?
  changePolicyContent    String?   @db.Text
  changePolicyUpdatedAt  DateTime?
  withdrawalRightContent   String?   @db.Text
  withdrawalRightUpdatedAt DateTime?

  // ── Landing page (editable desde admin) ───────────────────
  landingHeroTitle    String @default("Tu tienda, tus precios")
  landingHeroSubtitle String @default("Armá tu catálogo gratis")
  landingHeroDesc     String @default("Elegí productos de MBDA Modas, ponele tu precio y vendé a tus clientes.")
  landingCta1Text     String @default("Quiero ser revendedor")
  landingCta2Text     String @default("Ya tengo cuenta")
  landingHowTitle     String @default("¿Cómo funciona?")
  landingStep1Title   String @default("Registrate gratis")
  landingStep1Desc    String @default("Creá tu cuenta en minutos, sin costo.")
  landingStep2Title   String @default("Armá tu catálogo")
  landingStep2Desc    String @default("Elegí productos y definí tus precios.")
  landingStep3Title   String @default("Compartí y vendé")
  landingStep3Desc    String @default("Compartí tu link único y recibí pedidos.")

  // ── Landing — rediseño "fashion premium" (imagen + secciones extra) ──
  landingHeroImage    String?
  landingHeroVideo    String? // URL de video de fondo del hero (mp4). Si está, reemplaza a landingHeroImage.
  landingAboutText    String @default("Creamos una forma simple de emprender: vos elegís qué vender y a qué precio, MBDA se encarga del stock. Sin locales, sin inversión, sin vueltas.")
  landingManifesto    String @default("Creá tu emprendimiento de moda sin invertir un peso. Elegís los productos, ponés tu precio, nosotros nos ocupamos del resto.")
  landingFeaturesImage String? // imagen de fondo fija de la sección "Cómo funciona"
  landingStep1Video   String? // video de la card del paso 1 (reemplaza al ícono)
  landingStep2Video   String?
  landingStep3Video   String?

  // ── Landing — Beneficios (4 ítems editables desde admin) ────
  landingBenefit1Title String @default("Precios mayoristas")
  landingBenefit1Desc  String @default("Accedé al catálogo de MBDA al precio de fábrica y definí vos cuánto ganás en cada venta.")
  landingBenefit2Title String @default("Catálogo siempre actualizado")
  landingBenefit2Desc  String @default("Nuevos productos y colecciones disponibles para sumar a tu selección cuando quieras.")
  landingBenefit3Title String @default("Pedidos simples y directos")
  landingBenefit3Desc  String @default("Cargás la reserva, MBDA confirma el pago y se encarga de tenerlo listo para tu clienta.")
  landingBenefit4Title String @default("Acompañamiento real")
  landingBenefit4Desc  String @default("No estás sola: hay soporte para resolver dudas en cada paso de tu emprendimiento.")

  // ── Landing — mostrar/ocultar secciones de la Home (todas visibles por defecto) ──
  landingShowBenefits      Boolean @default(true)
  landingShowProcess       Boolean @default(true)
  landingShowCollection    Boolean @default(true)
  landingShowResellerStory Boolean @default(true)
  landingShowTestimonials  Boolean @default(true)
  landingShowFaq           Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("config")
}

// ─────────────────────────────────────────────────────────────
// TESTIMONIAL — Testimonio de revendedora mostrado en la Home pública.
// Contenido gestionado por admin (reemplaza a los ítems demo hardcodeados).
// ─────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(uuid())
  quote     String   @db.Text
  name      String
  city      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// ─────────────────────────────────────────────────────────────
// FAQ ITEM — Pregunta frecuente mostrada en la Home pública.
// ─────────────────────────────────────────────────────────────

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_items")
}
